<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
    activity_main.xml —— 主布局（App 外壳）
    ============================================================================
    【整体结构】（从外到内）
      DrawerLayout（rootLayout）………… 支持“侧边抽屉面板”的容器
      ├── 主内容区（垂直 LinearLayout）
      │     ├── 顶部工具栏容器 toolbarContainer（Toolbar：标题 AutoGLM Agent + 面板按钮 + 深浅色切换）
      │     ├── 分割线
      │     ├── FragmentContainerView（导航宿主：对话页 / 历史页 / 设置页）
      │     ├── 分割线
      │     └── BottomNavigationView（底部三个 Tab，原有功能，保留）
      └── 侧边 Agent 面板 agentPanel（抽屉内容：任务状态 / 屏幕识别 / 当前动作 / 执行日志 / 深色模式开关）

    【为什么对话列表不在这个文件里？】
      本工程的导航结构是“一个 Activity + 三个 Fragment”：
        MainActivity(activity_main.xml) → TaskFragment(fragment_task.xml) / HistoryFragment / SettingsFragment
      如果把对话列表直接写进 activity_main.xml，就必须删掉导航宿主，
      那么 HistoryFragment、SettingsFragment 将无法显示（等于删功能）。
      所以这里遵循原架构：
        · activity_main.xml  = 外壳：顶部工具栏 + 侧边面板 + 主题切换 + 导航宿主
        · fragment_task.xml  = 对话页面：消息列表 + 底部固定输入框
      两者共同构成完整的“豆包式对话界面”，且原有 Agent 功能一行未动。

    【关于顶部内边距】
      状态栏高度不是固定值（刘海屏/挖孔屏差别很大），所以不在 XML 里写死，
      而是在 MainActivity 里用 WindowInsets 动态补到 toolbarContainer 上：
        setupEdgeToEdgeInsets(toolbarContainer, applyTop = true)
    ============================================================================
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="false"
    tools:context=".MainActivity">

    <!-- ======================================================================
         一、主内容区
         ====================================================================== -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ==================================================================
             1.1 顶部工具栏容器
             background 放在“容器”上而不是 Toolbar 上，
             这样状态栏区域也会被染成同一个颜色，视觉上才是沉浸式的。
             ================================================================== -->
        <LinearLayout
            android:id="@+id/toolbarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/chat_toolbar_background"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationContentDescription="@string/chat_open_panel"
                app:navigationIcon="@drawable/ic_menu"
                app:title="@string/chat_toolbar_title"
                app:titleTextAppearance="@style/TextAppearance.App.ToolbarTitle">

                <!-- 右侧：一键切换深色 / 浅色模式 -->
                <ImageButton
                    android:id="@+id/btnThemeToggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/chat_theme_toggle"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_dark_mode"
                    app:tint="@color/text_primary" />
            </com.google.android.material.appbar.MaterialToolbar>
        </LinearLayout>

        <!-- 1.2 工具栏下方的极细分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- ==================================================================
             1.3 导航宿主（原有 Fragment 全部照旧挂在里面）
             layout_height="0dp" + layout_weight="1" 表示“占满中间剩余空间”
             ================================================================== -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_main" />

        <!-- 1.4 底部导航上方的分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- ==================================================================
             1.5 底部三个 Tab（对话 / 历史 / 设置）—— 原有功能，保持不变
             ================================================================== -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_background"
            android:minHeight="56dp"
            android:paddingTop="2dp"
            app:itemActiveIndicatorStyle="@null"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/bottom_nav_item_color"
            app:itemPaddingTop="2dp"
            app:itemTextColor="@color/bottom_nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_bottom_nav" />
    </LinearLayout>

    <!-- ======================================================================
         二、侧边 Agent 面板（抽屉）
         · android:layout_gravity="start" 表示从左侧滑出
         · 宽度 320dp；内容分“固定头部 / 状态卡片区 / 可滚动日志区 / 固定底部”
         ====================================================================== -->
    <LinearLayout
        android:id="@+id/agentPanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_panel"
        android:orientation="vertical">

        <!-- 2.1 面板头部：标题 + 收起按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/chat_panel_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <ImageButton
                android:id="@+id/btnClosePanel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_panel_collapse"
                android:src="@drawable/ic_close"
                app:tint="@color/icon_secondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 2.2 状态卡片区（任务状态 / 屏幕识别 / 当前动作） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp">

            <!-- 任务状态 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_panel_status_label"
                android:textAppearance="@style/TextAppearance.App.PanelLabel" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/chat_panel_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- 状态小圆点，颜色由代码根据任务状态设置 -->
                        <View
                            android:id="@+id/viewStatusDot"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/bg_avatar"
                            android:backgroundTint="@color/status_idle" />

                        <TextView
                            android:id="@+id/tvTaskStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/chat_status_idle"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvTaskStep"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text="第 3 步" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTaskDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="打开淘宝，搜索无线耳机"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 屏幕识别 / 模型思考 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/chat_panel_screen_label"
                android:textAppearance="@style/TextAppearance.App.PanelLabel" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/chat_panel_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvScreenUnderstanding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="8"
                    android:padding="14dp"
                    android:text="@string/chat_panel_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textIsSelectable="true" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 当前动作 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/chat_panel_action_label"
                android:textAppearance="@style/TextAppearance.App.PanelLabel" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/chat_panel_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvCurrentAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="4"
                    android:padding="14dp"
                    android:text="@string/chat_panel_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textIsSelectable="true" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 2.3 执行日志标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/chat_panel_log_label"
                android:textAppearance="@style/TextAppearance.App.PanelLabel" />

            <TextView
                android:id="@+id/tvLogAutoScrollHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chat_panel_label"
                android:textSize="11sp"
                tools:text="自动滚动" />
        </LinearLayout>

        <!-- 2.4 日志滚动区：占满剩余空间，可单独上下滚动 -->
        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:background="@color/log_background"
            android:padding="10dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvAgentLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_panel_log_empty"
                android:textAppearance="@style/TextAppearance.App.AgentLog"
                android:textIsSelectable="true" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 2.5 面板底部：深色模式开关 + 悬浮窗按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/chat_panel_dark_mode"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!--
                ⚠️ android:saveEnabled="false" 是修「一切换深浅色就黑白来回闪」的关键，不要删！

                CompoundButton（MaterialSwitch 的父类）默认会把 isChecked 存进
                onSaveInstanceState，Activity 重建后由 onRestoreInstanceState 恢复，
                **而恢复这个值会触发 OnCheckedChangeListener**。于是形成死循环：
                  切换主题 → 写偏好 → Activity 重建 → 开关被恢复成旧值(true)
                  → 监听器发现「开关显示深色、但当前已经是浅色」→ 又把主题改回深色
                  → 再重建 → 再恢复 …… 实测每秒 6~10 次，肉眼看到的就是黑白来回闪。
                开关的真实状态本来就以 ThemeController（SharedPreferences）为准，
                每次 onCreate / onResume 都会用 syncThemeSwitch() 校准，
                所以不需要系统帮我们保存/恢复它的勾选状态。
            -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchDarkMode"
                style="@style/Widget.App.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:saveEnabled="false" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPanelFloatingWindow"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="14dp"
            android:text="@string/quick_action_floating"
            app:icon="@drawable/ic_layers"
            app:iconGravity="textStart" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
